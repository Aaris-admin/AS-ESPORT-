# Uploaded files are untrusted. Never execute anything from this directory.
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|phps|pl|py|cgi|asp|aspx|sh|htaccess)$">
    Require all denied
</FilesMatch>
php_flag engine off
Options -ExecCGI -Indexes
AddType text/plain .php .phtml .php3 .php4 .php5 .php7 .phps
